{
  "name": "writedoc",
  "version": "1.0.0",
  "description": "writedoc: a fast, private word processor. Real .docx files, kept in your browser.",
  "author": "salim-slimani",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:licenses": "node tools/check-licenses.mjs",
    "prebuild": "npm run check:licenses",
    "test:browser": "playwright test",
    "check:conformance": "python3 tools/check-docx-schema.py",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "desktop:dist": "npm run build && electron-builder --win --x64",
    "desktop:dist:all": "npm run build && electron-builder --win --mac --linux",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleRelease"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salim-studio/writedoc.git"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@zip.js/zip.js": "2.14.1",
    "bidi-js": "1.0.3",
    "fflate": "0.8.3",
    "hast-util-to-html": "9.0.5",
    "lucide": "^1.34.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0",
    "nspell": "2.1.5",
    "opentype.js": "2.0.0",
    "rtf.js": "3.0.9",
    "utif": "3.1.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "commonmark": "0.31.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.writedoc.desktop",
    "productName": "writedoc",
    "copyright": "writedoc",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "writedoc-1.0.0-setup.exe"
    },
    "portable": {
      "artifactName": "writedoc-1.0.0-portable.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "icon.png"
    }
  }
}
